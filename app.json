{
  "expo": {
    "name": "Calendar",
    "slug": "calendar",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "calendar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anonymous.calendar"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.calendar"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
